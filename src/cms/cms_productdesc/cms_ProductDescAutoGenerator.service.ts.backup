  /**
   * Ensure single <ul> format by combining multiple <ul> blocks
   */
  private ensureSingleUlFormat(text: string): string {
    if (!text || typeof text !== 'string') return text;

    // Extract all <li> content
    const liMatches = text.match(/<li>(.*?)<\/li>/g);
    if (!liMatches || liMatches.length === 0) return text;

    // Create single <ul> with all <li>
    const liContents = liMatches.map((match) => match.replace(/<\/?li>/g, ''));
    const singleUl = `<ul>${liContents.map((content) => `<li>${content}</li>`).join('')}</ul>`;

    return singleUl;
  }

