        `   ⚡ TOTAL TIME: ${totalTime}ms (${(totalTime / 1000).toFixed(2)}s)`,
      );

      return result as Cms_ResponseProductDescDto;
    } catch (error) {
      this.logger.error(
        `Error translating product description with complete formatting for ID ${id}:`,
        error,
      );
      throw error;
    }
  }

  /**
   * Normalize HTML formatting for all products
   */
  async normalizeHtmlFormatting(
    company_id: string,
    updatedBy?: string,
  ): Promise<{
    successful: { id: string; fields: string[] }[];
    failed: { id: string; error: string }[];
  }> {
    const successful: { id: string; fields: string[] }[] = [];
    const failed: { id: string; error: string }[] = [];

    try {
      this.logger.log('🔧 Starting HTML formatting normalization...');

      // Fetch all products
      const allProducts = await this.prisma.imc_ProductDesc.findMany({
        where: {
          company_id: company_id,
          OR: [
            { descriptions: { not: null } },
            { descriptions_en: { not: null } },
            { benefits: { not: null } },
            { benefits_en: { not: null } },
          ],
        },
        select: {
          id: true,
          descriptions: true,
          descriptions_en: true,
          benefits: true,
          benefits_en: true,
        },
        orderBy: {
          id: 'asc',
        },
      });

      this.logger.log(`📊 Found ${allProducts.length} products to normalize`);

      for (const product of allProducts) {
        try {
          let needsUpdate = false;
          const updateData: any = {};

          // Normalize descriptions
          if (product.descriptions) {
            const normalizedDescriptions = this.ensureSingleUlFormat(
              product.descriptions,
            );
            if (normalizedDescriptions !== product.descriptions) {
              updateData.descriptions = normalizedDescriptions;
              needsUpdate = true;
            }
          }

          // Normalize descriptions_en
          if (product.descriptions_en) {
            const normalizedDescriptionsEn = this.ensureSingleUlFormat(
              product.descriptions_en,
            );
            if (normalizedDescriptionsEn !== product.descriptions_en) {
              updateData.descriptions_en = normalizedDescriptionsEn;
              needsUpdate = true;
            }
          }

          // Normalize benefits
          if (product.benefits) {
            const normalizedBenefits = this.ensureSingleUlFormat(
              product.benefits,
            );
            if (normalizedBenefits !== product.benefits) {
              updateData.benefits = normalizedBenefits;
              needsUpdate = true;
            }
          }

          // Normalize benefits_en
          if (product.benefits_en) {
            const normalizedBenefitsEn = this.ensureSingleUlFormat(
              product.benefits_en,
            );
            if (normalizedBenefitsEn !== product.benefits_en) {
              updateData.benefits_en = normalizedBenefitsEn;
              needsUpdate = true;
            }
          }

          if (needsUpdate) {
            await this.prisma.imc_ProductDesc.update({
              where: { id_company_id: { id: product.id, company_id } },
              data: {
                ...updateData,
                updatedBy: updatedBy || 'html-formatting-normalization',
                updatedAt: new Date(),
              },
            });

            successful.push({
              id: product.id,
              fields: Object.keys(updateData),
            });

            this.logger.log(`✅ Normalized formatting for ID: ${product.id}`);
          }
        } catch (error) {
          failed.push({
            id: product.id,
            error: error instanceof Error ? error.message : 'Unknown error',
          });
          this.logger.error(
            `❌ Failed to normalize ID: ${product.id} - ${error}`,
          );
        }
      }

      this.logger.log(`🎉 HTML formatting normalization completed!`);
      this.logger.log(`   ✅ Successful: ${successful.length}`);
      this.logger.log(`   ❌ Failed: ${failed.length}`);

      return { successful, failed };
    } catch (error) {
      this.logger.error('Error during HTML formatting normalization:', error);
      throw error;
    }
  }

  /**
   * Translate multiple product descriptions to English
   */
  async translateBulkProductDescriptions(
    productIds: string[],
    company_id: string,
    updatedBy?: string,
  ): Promise<{
    successful: Cms_ResponseProductDescDto[];
    failed: { id: string; error: string }[];
  }> {
    const successful: Cms_ResponseProductDescDto[] = [];
    const failed: { id: string; error: string }[] = [];

    for (const id of productIds) {
      try {
        const result = await this.translateProductDescription(
          id,
          company_id,
          updatedBy,
        );
        successful.push(result);
      } catch (error) {
        failed.push({
          id,
          error: error instanceof Error ? error.message : 'Unknown error',
        });
      }
    }

    return { successful, failed };
  }

  /**
   * Translate multiple product descriptions with complete formatting
   */
  async translateBulkProductDescriptionsWithCompleteFormatting(
    productIds: string[],
    company_id: string,
    updatedBy?: string,
  ): Promise<{
    successful: Cms_ResponseProductDescDto[];
    failed: { id: string; error: string }[];
  }> {
    const successful: Cms_ResponseProductDescDto[] = [];
    const failed: { id: string; error: string }[] = [];

    for (const id of productIds) {
      try {
        const result =
          await this.translateProductDescriptionWithCompleteFormatting(
            id,
            company_id,
            updatedBy,
          );
        successful.push(result);
      } catch (error) {
        failed.push({
          id,
          error: error instanceof Error ? error.message : 'Unknown error',
        });
      }
    }

    return { successful, failed };
  }
}
