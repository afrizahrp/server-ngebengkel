  /**
   * Translate existing Indonesian content to English with consistent formatting
   */
  async translateContentToEnglish(
    descriptions: string,
    benefits: string,
  ): Promise<{ descriptions_en: string; benefits_en: string }> {
    try {
      this.logger.log('Starting translation to English...');

      const systemPrompt = `
      You are a professional medical translator. 
      Your task is to translate Indonesian text into clear, natural American English.
      
      REQUIREMENTS:
      - Translate ALL Indonesian words (do not leave any Indonesian word untranslated).
      - Maintain medical terminology accurately in English.
      - Keep HTML formatting EXACTLY as provided.
      - Ensure bullet point count matches between Indonesian and English versions.
      - Output MUST be valid JSON with keys: descriptions_en, benefits_en.
      - Do not add explanations or extra fields.
      - Use complete sentences and professional grammar.
      `;

      const userPrompt = `
Translate the following Indonesian content into American English. Make sure the number of bullet points matches exactly.

DESCRIPTIONS (Indonesian):
${descriptions}

BENEFITS (Indonesian):
${benefits}

EXAMPLE OUTPUT (format only, replace with translation):
{
  "descriptions_en": "<p><strong>Medical Equipment</strong> - Professional medical device designed for healthcare facilities...</p><ul><li><strong>Safety:</strong> Advanced safety features ensure patient protection...</li></ul>",
  "benefits_en": "<ul><li><strong>Safety:</strong> Advanced safety features ensure patient protection...</li></ul>"
}`;

      this.logger.log('Calling OpenAI for translation...');
      const response = await this.callOpenAIAPI(systemPrompt, userPrompt);
      this.logger.log(
        `Translation response received (${response.length} chars)`,
      );

      // Parse JSON response
      try {
        const parsedResponse = JSON.parse(response) as {
          descriptions_en?: string;
          benefits_en?: string;
        };
        this.logger.log('✅ Successfully parsed translation JSON response');

        // Ensure single <ul> format
        const formattedDescriptionsEn = this.ensureSingleUlFormat(
          parsedResponse.descriptions_en || descriptions,
        );
        const formattedBenefitsEn = this.ensureSingleUlFormat(
          parsedResponse.benefits_en || benefits,
        );

        // Verify bullet count consistency
        const originalDescBulletCount = this.countBulletPoints(descriptions);
        const originalBenefitsBulletCount = this.countBulletPoints(benefits);
        const newDescEnBulletCount = this.countBulletPoints(
          formattedDescriptionsEn,
        );
        const newBenefitsEnBulletCount =
          this.countBulletPoints(formattedBenefitsEn);

        this.logger.log(`📊 Bullet count verification:`);
        this.logger.log(
          `   - Descriptions: ${originalDescBulletCount} → ${newDescEnBulletCount}`,
        );
        this.logger.log(
          `   - Benefits: ${originalBenefitsBulletCount} → ${newBenefitsEnBulletCount}`,
        );

        return {
          descriptions_en: formattedDescriptionsEn,
          benefits_en: formattedBenefitsEn,
        };
      } catch (parseError) {
        this.logger.error('Error parsing translation response:', parseError);
        this.logger.error('Raw response:', response);
        this.logger.log('Falling back to original content...');

        // Fallback: return original content if translation fails
        return {
          descriptions_en: descriptions,
          benefits_en: benefits,
        };
      }
    } catch (error) {
      this.logger.error('Error translating content:', error);
      // Fallback: return original content
      return {
        descriptions_en: descriptions,
        benefits_en: benefits,
      };
    }
  }

  /**
   * Translate content with complete formatting (including paragraphs)
   */
  async translateContentWithCompleteFormatting(
    descriptions: string,
    benefits: string,
  ): Promise<{ descriptions_en: string; benefits_en: string }> {
    try {
      this.logger.log('Starting complete translation with formatting...');

      // Extract components first
      const introParagraph = this.extractIntroParagraph(descriptions);
      const descBulletPoints = this.extractBulletPoints(descriptions);
      const benefitsBulletPoints = this.extractBulletPoints(benefits);

      this.logger.log(`📊 Extracted components:`);
      this.logger.log(`   - Intro paragraph: ${introParagraph.length} chars`);
      this.logger.log(`   - Description bullets: ${descBulletPoints.length}`);
      this.logger.log(`   - Benefits bullets: ${benefitsBulletPoints.length}`);

      // Translate components separately for better reliability
      const translatedIntro = await this.simpleTranslate(introParagraph);
      this.logger.log('✅ Translated intro paragraph');

      // Translate description bullet points
      const translatedDescBullets: string[] = [];
      for (let i = 0; i < descBulletPoints.length; i++) {
        const bullet = descBulletPoints[i];
        const translatedBullet = await this.simpleTranslate(bullet);
        translatedDescBullets.push(translatedBullet);
        this.logger.log(
          `✅ Translated description bullet ${i + 1}/${descBulletPoints.length}`,
        );

        // Small delay to avoid rate limiting
        await new Promise((resolve) => setTimeout(resolve, 100));
      }

      // Translate benefits bullet points
      const translatedBenefitsBullets: string[] = [];
      for (let i = 0; i < benefitsBulletPoints.length; i++) {
        const bullet = benefitsBulletPoints[i];
        const translatedBullet = await this.simpleTranslate(bullet);
        translatedBenefitsBullets.push(translatedBullet);
        this.logger.log(
          `✅ Translated benefits bullet ${i + 1}/${benefitsBulletPoints.length}`,
        );

        // Small delay to avoid rate limiting
        await new Promise((resolve) => setTimeout(resolve, 100));
      }

      // Combine results
      const newDescriptionsEn = `${translatedIntro}\n\n<ul>${translatedDescBullets.map((bullet) => `<li>${bullet}</li>`).join('')}</ul>`;
      const newBenefitsEn = `<ul>${translatedBenefitsBullets.map((bullet) => `<li>${bullet}</li>`).join('')}</ul>`;

      // Verify bullet count consistency
      const originalDescBulletCount = this.countBulletPoints(descriptions);
      const originalBenefitsBulletCount = this.countBulletPoints(benefits);
      const newDescEnBulletCount = this.countBulletPoints(newDescriptionsEn);
      const newBenefitsEnBulletCount = this.countBulletPoints(newBenefitsEn);

      this.logger.log(`📊 Complete translation bullet count verification:`);
      this.logger.log(
        `   - Descriptions: ${originalDescBulletCount} → ${newDescEnBulletCount}`,
      );
      this.logger.log(
        `   - Benefits: ${originalBenefitsBulletCount} → ${newBenefitsEnBulletCount}`,
      );

      return {
        descriptions_en: newDescriptionsEn,
        benefits_en: newBenefitsEn,
      };
    } catch (error) {
      this.logger.error('Error in complete translation:', error);
      // Fallback: return original content
      return {
        descriptions_en: descriptions,
        benefits_en: benefits,
      };
    }
  }

  /**
   * Translate existing product description to English
   */
  async translateProductDescription(
    id: string,
    company_id: string,
    updatedBy?: string,
  ): Promise<Cms_ResponseProductDescDto> {
    const startTime = Date.now();

    try {
      this.logger.log(`🔄 Starting translation for product ID: ${id}`);

      // Step 1: Fetch existing product description
      const fetchStart = Date.now();
      const existingDesc = await this.prisma.imc_ProductDesc.findUnique({
        where: { id_company_id: { id, company_id } },
      });
      const fetchTime = Date.now() - fetchStart;

      if (!existingDesc) {
        throw new NotFoundException(
          `Product description with ID ${id} not found`,
        );
      }

      if (!existingDesc.descriptions || !existingDesc.benefits) {
        throw new Error('No Indonesian content found to translate');
      }

      this.logger.log(`✅ Fetched existing description (${fetchTime}ms)`);

      // Step 2: Translate content
      const translateStart = Date.now();
      const translated = await this.translateContentToEnglish(
        existingDesc.descriptions,
        existingDesc.benefits,
      );
      const translateTime = Date.now() - translateStart;
      this.logger.log(`✅ Translated content (${translateTime}ms)`);

      // Step 3: Update with English translations
      const updateStart = Date.now();
      const result = await this.prisma.imc_ProductDesc.update({
        where: { id_company_id: { id, company_id } },
        data: {
          descriptions_en: translated.descriptions_en,
          benefits_en: translated.benefits_en,
          updatedBy: updatedBy || 'system',
          updatedAt: new Date(),
        },
      });
      const updateTime = Date.now() - updateStart;
      const totalTime = Date.now() - startTime;

      this.logger.log(
        `🎉 Successfully translated content for product ID: ${id}`,
      );
      this.logger.log(`⏱️  TRANSLATION TIMING:`);
      this.logger.log(`   📊 Fetch Description: ${fetchTime}ms`);
      this.logger.log(`   🔄 Translate Content: ${translateTime}ms`);
      this.logger.log(`   💾 Update Database: ${updateTime}ms`);
      this.logger.log(
        `   ⚡ TOTAL TIME: ${totalTime}ms (${(totalTime / 1000).toFixed(2)}s)`,
      );

      return result as Cms_ResponseProductDescDto;
    } catch (error) {
      this.logger.error(
        `Error translating product description for ID ${id}:`,
        error,
      );
      throw error;
    }
  }

  /**
   * Generate content for multiple products
   */
  async generateBulkContent(
    productIds: string[],
    company_id: string,
    createdBy?: string,
    updatedBy?: string,
  ): Promise<{
    successful: Cms_ResponseProductDescDto[];
    failed: { id: string; error: string }[];
  }> {
    const successful: Cms_ResponseProductDescDto[] = [];
    const failed: { id: string; error: string }[] = [];

    for (const id of productIds) {
      try {
        const result = await this.generateAutomaticContent(
          id,
          company_id,
          createdBy,
          updatedBy,
        );
        successful.push(result);
      } catch (error) {
        failed.push({
          id,
          error: error instanceof Error ? error.message : 'Unknown error',
        });
      }
    }

    return { successful, failed };
  }

