  /**
   * Insert or update product description
   */
  async upsertProductDescription(
    id: string,
    company_id: string,
    content: GeneratedContent,
    createdBy?: string,
    updatedBy?: string,
  ): Promise<Cms_ResponseProductDescDto> {
    try {
      const existingDesc = await this.prisma.imc_ProductDesc.findUnique({
        where: { id_company_id: { id, company_id } },
      });

      const data = {
        id,
        company_id,
        descriptions: content.descriptions,
        descriptions_en: content.descriptions_en,
        benefits: content.benefits,
        benefits_en: content.benefits_en,
        updatedBy: updatedBy || createdBy,
        updatedAt: new Date(),
      };

      let result;
      if (existingDesc) {
        // Update existing record
        result = await this.prisma.imc_ProductDesc.update({
          where: { id_company_id: { id, company_id } },
          data,
        });
      } else {
        // Create new record
        result = await this.prisma.imc_ProductDesc.create({
          data: {
            ...data,
            createdBy: createdBy || 'system',
            createdAt: new Date(),
            branch_id: '', // Default branch_id
          },
        });
      }

      return result as Cms_ResponseProductDescDto;
    } catch (error) {
      this.logger.error(
        `Error upserting product description for ID ${id}:`,
        error,
      );
      throw error;
    }
  }

  /**
   * Main orchestration function to generate content automatically
   */
  async generateAutomaticContent(
    id: string,
    company_id: string,
    createdBy?: string,
    updatedBy?: string,
  ): Promise<Cms_ResponseProductDescDto> {
    const startTime = Date.now();
    const timings = {
      fetchSpec: 0,
      convertSpec: 0,
      generateContent: 0,
      saveToDb: 0,
      total: 0,
    };

    try {
      this.logger.log(`🚀 Starting content generation for product ID: ${id}`);

      // Step 1: Fetch product specifications
      const fetchStart = Date.now();
      const productSpec = await this.fetchProductSpecById(id, company_id);
      timings.fetchSpec = Date.now() - fetchStart;
      this.logger.log(`✅ Fetched product spec (${timings.fetchSpec}ms)`);

      // Step 2: Convert specifications to text
      const convertStart = Date.now();
      const specifications = this.convertSpecsToText(productSpec);
      timings.convertSpec = Date.now() - convertStart;
      this.logger.log(
        `✅ Converted specifications (${specifications.length} chars, ${timings.convertSpec}ms)`,
      );

      if (!specifications.trim()) {
        throw new Error('No valid specifications found for content generation');
      }

      // Step 3: Generate content using OpenAI
      const generateStart = Date.now();
      const generatedContent =
        await this.generateProductContent(specifications);
      timings.generateContent = Date.now() - generateStart;
      this.logger.log(`✅ Generated content (${timings.generateContent}ms)`);

      // Step 4: Save to database
      const saveStart = Date.now();
      const result = await this.upsertProductDescription(
        id,
        company_id,
        generatedContent,
        createdBy,
        updatedBy,
      );
      timings.saveToDb = Date.now() - saveStart;
      timings.total = Date.now() - startTime;

      this.logger.log(
        `🎉 Successfully generated and saved content for product ID: ${id}`,
      );
      this.logger.log(`⏱️  PERFORMANCE TIMING:`);
      this.logger.log(`   📊 Fetch Specs: ${timings.fetchSpec}ms`);
      this.logger.log(`   🔄 Convert Specs: ${timings.convertSpec}ms`);
      this.logger.log(`   🤖 Generate Content: ${timings.generateContent}ms`);
      this.logger.log(`   💾 Save to DB: ${timings.saveToDb}ms`);
      this.logger.log(
        `   ⚡ TOTAL TIME: ${timings.total}ms (${(timings.total / 1000).toFixed(2)}s)`,
      );

      return result;
    } catch (error) {
      this.logger.error(
        `Error in automatic content generation for ID ${id}:`,
        error,
      );
      throw error;
    }
  }

  /**
   * Count bullet points in text
   */
  private countBulletPoints(text: string): number {
    if (!text || typeof text !== 'string') return 0;
    const liMatches = text.match(/<li>/g);
    return liMatches ? liMatches.length : 0;
  }

  /**
   * Extract introductory paragraph from descriptions
   */
  private extractIntroParagraph(descriptions: string): string {
    if (!descriptions || typeof descriptions !== 'string') return '';

    const beforeUlMatch = descriptions.match(/^(.*?)(<ul>|<li>)/s);
    if (beforeUlMatch) {
      const introText = beforeUlMatch[1].trim();
      return introText
        .replace(/<br\s*\/?>/gi, ' ')
        .replace(/\s+/g, ' ')
        .trim();
    }

    return '';
  }

  /**
   * Extract all bullet points from descriptions or benefits
   */
  private extractBulletPoints(descriptions: string): string[] {
    if (!descriptions || typeof descriptions !== 'string') return [];

    const liMatches = descriptions.match(/<li>(.*?)<\/li>/g);
    if (!liMatches) return [];

    return liMatches.map((match) => match.replace(/<\/?li>/g, ''));
  }

  /**
   * Simple translation method for individual components
   */
  private async simpleTranslate(text: string): Promise<string> {
    try {
      const prompt = `Translate the following Indonesian text to American English. Keep the HTML formatting intact.

${text}`;

      const response = await this.callOpenAIAPI('', prompt);
      return response.trim();
    } catch (error) {
      this.logger.error('Error in simple translation:', error);
      return text;
    }
  }

  /**
   * Get bullet count information for a product
   */
  async getBulletCountInfo(
    id: string,
    company_id: string,
  ): Promise<{
    id: string;
    descriptions_bullet_count: number;
    descriptions_en_bullet_count: number;
    benefits_bullet_count: number;
    benefits_en_bullet_count: number;
    is_consistent: boolean;
  }> {
    try {
      const product = await this.prisma.imc_ProductDesc.findUnique({
        where: { id_company_id: { id, company_id } },
        select: {
          id: true,
          descriptions: true,
          descriptions_en: true,
          benefits: true,
          benefits_en: true,
        },
      });

      if (!product) {
        throw new NotFoundException(`Product with ID ${id} not found`);
      }

      const descriptionsBulletCount = this.countBulletPoints(
        product.descriptions || '',
      );
      const descriptionsEnBulletCount = this.countBulletPoints(
        product.descriptions_en || '',
      );
      const benefitsBulletCount = this.countBulletPoints(
        product.benefits || '',
      );
      const benefitsEnBulletCount = this.countBulletPoints(
        product.benefits_en || '',
      );

      const isConsistent =
        descriptionsBulletCount === descriptionsEnBulletCount &&
        benefitsBulletCount === benefitsEnBulletCount;

      return {
        id: product.id,
        descriptions_bullet_count: descriptionsBulletCount,
        descriptions_en_bullet_count: descriptionsEnBulletCount,
        benefits_bullet_count: benefitsBulletCount,
        benefits_en_bullet_count: benefitsEnBulletCount,
        is_consistent: isConsistent,
      };
    } catch (error) {
      this.logger.error(`Error getting bullet count info for ID ${id}:`, error);
      throw error;
    }
  }

  /**
   * Get all products that need formatting normalization
   */
  async getProductsNeedingNormalization(company_id: string): Promise<
    {
      id: string;
      needs_descriptions_normalization: boolean;
      needs_descriptions_en_normalization: boolean;
      needs_benefits_normalization: boolean;
      needs_benefits_en_normalization: boolean;
      total_needs_normalization: boolean;
    }[]
  > {
    try {
      const allProducts = await this.prisma.imc_ProductDesc.findMany({
        where: {
          company_id: company_id,
          OR: [
            { descriptions: { not: null } },
            { descriptions_en: { not: null } },
            { benefits: { not: null } },
            { benefits_en: { not: null } },
          ],
        },
        select: {
          id: true,
          descriptions: true,
          descriptions_en: true,
          benefits: true,
          benefits_en: true,
        },
        orderBy: {
          id: 'asc',
        },
      });

      return allProducts.map((product) => {
        const needsDescriptionsNormalization = product.descriptions
          ? this.ensureSingleUlFormat(product.descriptions) !==
            product.descriptions
          : false;
        const needsDescriptionsEnNormalization = product.descriptions_en
          ? this.ensureSingleUlFormat(product.descriptions_en) !==
            product.descriptions_en
          : false;
        const needsBenefitsNormalization = product.benefits
          ? this.ensureSingleUlFormat(product.benefits) !== product.benefits
          : false;
        const needsBenefitsEnNormalization = product.benefits_en
          ? this.ensureSingleUlFormat(product.benefits_en) !==
            product.benefits_en
          : false;

        const totalNeedsNormalization =
          needsDescriptionsNormalization ||
          needsDescriptionsEnNormalization ||
          needsBenefitsNormalization ||
          needsBenefitsEnNormalization;

        return {
          id: product.id,
          needs_descriptions_normalization: needsDescriptionsNormalization,
          needs_descriptions_en_normalization: needsDescriptionsEnNormalization,
          needs_benefits_normalization: needsBenefitsNormalization,
          needs_benefits_en_normalization: needsBenefitsEnNormalization,
          total_needs_normalization: totalNeedsNormalization,
        };
      });
    } catch (error) {
      this.logger.error('Error getting products needing normalization:', error);
      throw error;
    }
  }

  /**
   * Get all products that need translation
   */
  async getProductsNeedingTranslation(company_id: string): Promise<
    {
      id: string;
      has_descriptions: boolean;
      has_descriptions_en: boolean;
      has_benefits: boolean;
      has_benefits_en: boolean;
      needs_translation: boolean;
    }[]
  > {
    try {
      const allProducts = await this.prisma.imc_ProductDesc.findMany({
        where: {
          company_id: company_id,
          OR: [
            { descriptions: { not: null } },
            { descriptions_en: { not: null } },
            { benefits: { not: null } },
            { benefits_en: { not: null } },
          ],
        },
        select: {
          id: true,
          descriptions: true,
          descriptions_en: true,
          benefits: true,
          benefits_en: true,
        },
        orderBy: {
          id: 'asc',
        },
      });

      return allProducts.map((product) => {
        const hasDescriptions = !!product.descriptions;
        const hasDescriptionsEn = !!product.descriptions_en;
        const hasBenefits = !!product.benefits;
        const hasBenefitsEn = !!product.benefits_en;

        const needsTranslation =
          (hasDescriptions && !hasDescriptionsEn) ||
          (hasBenefits && !hasBenefitsEn);

        return {
          id: product.id,
          has_descriptions: hasDescriptions,
          has_descriptions_en: hasDescriptionsEn,
          has_benefits: hasBenefits,
          has_benefits_en: hasBenefitsEn,
          needs_translation: needsTranslation,
        };
      });
    } catch (error) {
      this.logger.error('Error getting products needing translation:', error);
      throw error;
    }
  }

  /**
