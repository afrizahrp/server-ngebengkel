    return JSON.stringify({
      descriptions:
        '<p><strong>Produk Medis Berkualitas Tinggi</strong> - Dirancang khusus untuk lingkungan perawatan kesehatan dengan standar medis internasional. Produk ini menggunakan bahan berkualitas tinggi dan teknologi canggih untuk memastikan performa optimal dalam aplikasi klinis.</p><p><br></p><ul><li><strong>Konstruksi Kokoh:</strong> Terbuat dari bahan berkualitas tinggi untuk ketahanan jangka panjang</li></ul><p><br></p><ul><li><strong>Standar Medis:</strong> Memenuhi standar regulasi medis internasional</li></ul><p><br></p><ul><li><strong>Desain Ergonomis:</strong> Dirancang untuk kemudahan penggunaan oleh tenaga medis</li></ul>',
      descriptions_en:
        '<p><strong>Clinical-Grade Medical Equipment</strong> - Engineered specifically for NHS healthcare environments with adherence to UK medical device regulations. This equipment utilises clinical-grade materials and advanced technology to ensure optimal clinical performance in healthcare applications.</p><p><br></p><ul><li><strong>Robust Clinical Construction:</strong> Manufactured from clinical-grade materials ensuring long-term clinical durability</li></ul><p><br></p><ul><li><strong>NHS Compliance:</strong> Meets UK medical device regulatory standards and NHS procurement requirements</li></ul><p><br></p><ul><li><strong>Ergonomic Clinical Design:</strong> Designed for optimal use by healthcare professionals in clinical settings</li></ul>',
      benefits:
        '<ul><li><strong>Keamanan dan Keandalan:</strong> Memastikan keamanan pasien dan keandalan operasional dalam lingkungan perawatan kesehatan</li></ul><p><br></p><ul><li><strong>Kualitas Medis Tinggi:</strong> Dibuat dengan standar kualitas medis yang ketat untuk aplikasi klinis</li></ul><p><br></p><ul><li><strong>Mudah Perawatan:</strong> Dirancang untuk kemudahan pembersihan dan perawatan rutin</li></ul><p><br></p><ul><li><strong>Fleksibilitas Penggunaan:</strong> Dapat digunakan dalam berbagai aplikasi perawatan kesehatan</li></ul><p><br></p><ul><li><strong>Kepatuhan Regulasi:</strong> Memenuhi standar regulasi medis internasional</li></ul>',
      benefits_en:
