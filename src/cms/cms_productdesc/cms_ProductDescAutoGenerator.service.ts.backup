import { Injectable, NotFoundException, Logger } from '@nestjs/common';
import { PrismaService } from 'src/prisma.service';
import { Cms_ResponseProductDescDto } from './dto/cms_ResponseProductDesc.dto';
import { OpenAIService } from './openai.service';

// Type definitions
interface ProductSpec {
  [key: string]: string | null | undefined | Date;
}

interface OpenAIResponse {
  choices: Array<{
    message: {
      content: string;
    };
  }>;
  error?: {
    message?: string;
  };
}

interface GeneratedContent {
  descriptions: string;
  descriptions_en: string;
  benefits: string;
  benefits_en: string;
}

@Injectable()
export class cms_ProductDescAutoGeneratorService {
  private readonly logger = new Logger(
    cms_ProductDescAutoGeneratorService.name,
  );

  constructor(
    private prisma: PrismaService,
    private openaiService: OpenAIService,
  ) {}

  /**
   * Fetch product specifications by ID
   */
  async fetchProductSpecById(
    id: string,
    company_id: string,
  ): Promise<ProductSpec> {
    try {
      const productSpec = await this.prisma.imc_ProductSpec.findFirst({
        where: {
          id: id,
          company_id: company_id,
        },
      });

      if (!productSpec) {
        throw new NotFoundException(
          `Product specification with ID ${id} not found`,
        );
      }

      return productSpec;
    } catch (error) {
      this.logger.error(`Error fetching product spec for ID ${id}:`, error);
      throw error;
    }
  }

  /**
   * Convert product specifications to a combined text format
   */
  convertSpecsToText(productSpec: ProductSpec): string {
    const specFields = [
      'itemFunctions',
      'item_type',
      'item_model',
      'construction',
      'mattress',
      'mattressSize',
      'mattressThickness',
      'finishing',
      'dimension',
      'powerSupply',
      'loadCapacity',
      'systemFilter',
      'accessories',
      'sideRail',
      'ivStand',
      'wheels',
      'maxLoad',
      'size',
      'weight',
      'standSize',
      'position',
      'base',
      'basePlate',
      'cover',
      'material',
      'coverMaterial',
      'typeScreen',
      'powerConsumption',
      'lamp',
      'movers',
      'rim',
      'custodyFeet',
      'foot',
      'footWear',
      'pole',
      'inputVoltage',
      'outputVoltage',
      'sideGuard',
      'footandheadPanel',
      'temperatureControl',
      'top',
      'foodTray',
      'traycorpse',
      'pillowthecorpse',
      'lightPole',
      'sterilizing',
      'filter',
      'bodyFrame',
      'underPressure',
      'foundationTray',
      'door',
      'handle',
      'medicineBox',
      'handleTrolley',
      'drawer',
      'systemControl',
      'bodyFrameWork',
      'remarks',
    ];

    const specifications: string[] = [];

    specFields.forEach((field) => {
      const value = productSpec[field];
      if (value && typeof value === 'string' && value.trim() !== '') {
        // Convert camelCase to readable format
        const readableField = field
          .replace(/([A-Z])/g, ' $1')
          .replace(/^./, (str) => str.toUpperCase())
          .trim();
        specifications.push(`${readableField}: ${value}`);
      }
    });

    return specifications.join('\n');
  }

  /**
   * Generate product descriptions and benefits using OpenAI
   */
  async generateProductContent(
    specifications: string,
  ): Promise<GeneratedContent> {
    try {
      this.logger.log('Starting content generation...');
      this.logger.log(
        `Specifications length: ${specifications.length} characters`,
      );

      const systemPrompt = `You are a professional medical equipment copywriter specializing in NHS and UK healthcare equipment catalogs. 
You create detailed, technical product descriptions that explain WHY specific materials and specifications matter for clinical applications in UK healthcare settings. 
Focus on NHS compliance, UK medical standards, and evidence-based clinical benefits while avoiding generic marketing language.`;

      const userPrompt = `Generate comprehensive product descriptions and benefits in two languages (Indonesian and English) 
from the following product specification:
${specifications}

CRITICAL REQUIREMENTS:
- Output as JSON with fields: descriptions, descriptions_en, benefits, benefits_en
- Use rich HTML formatting with <p>, <strong>, <ul>, <li>, <h2>, <h3> tags
- EXPLAIN WHY each specification matters for medical use
- Connect technical specs to clinical benefits
- Write in professional medical terminology
- Structure content for healthcare professionals and procurement teams

FORMAT SPECIFICATIONS:

descriptions (Indonesian):
- Start with product name and key technical features
- For each specification, explain WHY it matters for medical use
- Example: "Terbuat dari steel hollow, sehingga memberikan daya tahan jangka panjang dan tidak mengurangi kenyamanan pasien"
- Include construction materials, dimensions, and technical specs with medical context
- Describe main features with <strong> tags for emphasis
- Use <p> tags for paragraphs and <ul><li> for feature lists
- End with comprehensive feature list using <ul><li> structure

descriptions_en (English - UK):
- Professional British English version of the same content
- Use NHS and UK medical terminology (British spelling: "colour", "centre", "realise")
- Maintain same HTML structure as Indonesian version
- Focus on clinical applications and NHS compliance
- Use "healthcare professionals" instead of "medical staff"
- Emphasise "clinical efficacy" and "patient outcomes"
- Example: "Manufactured from steel hollow construction, ensuring long-term clinical durability without compromising patient comfort in NHS healthcare environments"

benefits (Indonesian):
- Use <ul><li> structure with <strong> tags for benefit titles
- Include 5-8 key benefits with detailed explanations
- Connect each benefit to specific technical specifications
- Focus on clinical advantages, safety features, and operational benefits
- Use professional medical language

benefits_en (English - UK):
- British English version of the same benefits
- Maintain same structure and detail level
- Use NHS and UK medical terminology for UK healthcare markets
- Focus on clinical outcomes and evidence-based benefits
- Avoid generic marketing language - be specific and clinical

EXAMPLE FORMAT:
descriptions: "<p>Product Name dengan <strong>konstruksi steel hollow</strong> yang memberikan daya tahan jangka panjang dan tidak mengurangi kenyamanan pasien...</p><ul><li><strong>Konstruksi Kokoh:</strong> Terbuat dari steel hollow 40×40×1.5mm yang memastikan stabilitas maksimal untuk perawatan pasien</li></ul>"
descriptions_en: "<p><strong>Clinical-Grade Medical Equipment</strong> - Manufactured from steel hollow construction ensuring long-term clinical durability without compromising patient comfort in NHS healthcare environments...</p><ul><li><strong>Robust Clinical Construction:</strong> Constructed from 40×40×1.5mm steel hollow ensuring maximum stability for patient care applications</li></ul>"
benefits: "<ul><li><strong>Daya Tahan Tinggi:</strong> Konstruksi steel hollow memastikan peralatan dapat digunakan dalam jangka waktu yang lama tanpa kehilangan performa</li></ul>"
benefits_en: "<ul><li><strong>Clinical Durability:</strong> Steel hollow construction ensures equipment maintains clinical performance over extended periods without degradation</li></ul>"

IMPORTANT: Always explain WHY each specification matters for medical use. Connect technical details to clinical benefits.`;

      this.logger.log('Calling OpenAI API...');
      const response = await this.callOpenAIAPI(systemPrompt, userPrompt);
      this.logger.log(`OpenAI response received (${response.length} chars)`);

      // Parse JSON response
      try {
        const parsedResponse = JSON.parse(
          response,
        ) as Partial<GeneratedContent>;
        this.logger.log('✅ Successfully parsed OpenAI JSON response');

        return {
          descriptions: parsedResponse.descriptions || '',
          descriptions_en: parsedResponse.descriptions_en || '',
          benefits: parsedResponse.benefits || '',
          benefits_en: parsedResponse.benefits_en || '',
        };
      } catch (parseError) {
        this.logger.error('Error parsing OpenAI response:', parseError);
        this.logger.error('Raw response:', response);
        this.logger.log('Falling back to content extraction...');
        // Fallback: try to extract content from response
        return this.extractContentFromResponse(response);
      }
    } catch (error) {
      this.logger.error('Error generating product content:', error);
      this.logger.error('Error details:', error);
      throw new Error('Failed to generate product content');
    }
  }

  /**
   * Call OpenAI API with system and user prompts
   */
  private async callOpenAIAPI(
    systemPrompt: string,
    userPrompt: string,
  ): Promise<string> {
    const apiKey = process.env.OPENAI_API_KEY;
    const baseURL = process.env.OPENAI_BASE_URL || 'https://api.openai.com/v1';
    const model = 'gpt-4o';

    this.logger.log(`OpenAI API: ${apiKey ? 'Configured' : 'Not configured'}`);

    if (!apiKey) {
      this.logger.warn('❌ OpenAI API key not configured, using mock response');
      this.logger.warn('Please set OPENAI_API_KEY environment variable');
      this.logger.warn('Example: OPENAI_API_KEY=sk-...');
      return this.getMockResponse();
    }

    this.logger.log('✅ Calling OpenAI API...');

    try {
      const response = await fetch(`${baseURL}/chat/completions`, {
        method: 'POST',
        headers: {
          Authorization: `Bearer ${apiKey}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          model: model,
          messages: [
            {
              role: 'system',
              content: systemPrompt,
            },
            {
              role: 'user',
              content: userPrompt,
            },
          ],
          max_tokens: 2000,
          temperature: 0.7,
        }),
      });

      if (!response.ok) {
        const errorData = (await response.json()) as OpenAIResponse;
        this.logger.error(
          `OpenAI API error: ${response.status} - ${errorData.error?.message || ''}`,
        );
        throw new Error(
          `OpenAI API error: ${response.statusText} - ${errorData.error?.message || ''}`,
        );
      }

      const data = (await response.json()) as OpenAIResponse;
      this.logger.log('✅ OpenAI API response received');

      if (!data.choices || data.choices.length === 0) {
        throw new Error('No choices returned from OpenAI API');
      }

      return data.choices[0].message.content;
    } catch (error) {
      this.logger.error('❌ OpenAI API call failed:', error);
      this.logger.error('Error details:', error);
      this.logger.warn('Falling back to mock response');
      // Fallback to mock response if API fails
      return this.getMockResponse();
    }
  }

  /**
   * Extract content from OpenAI response if JSON parsing fails
   */
  private extractContentFromResponse(response: string): GeneratedContent {
    // Try to extract content using regex patterns
    const descriptionsMatch = response.match(
      /descriptions["\s]*:["\s]*"([^"]+)"/i,
    );
    const descriptionsEnMatch = response.match(
      /descriptions_en["\s]*:["\s]*"([^"]+)"/i,
    );
    const benefitsMatch = response.match(/benefits["\s]*:["\s]*"([^"]+)"/i);
    const benefitsEnMatch = response.match(
      /benefits_en["\s]*:["\s]*"([^"]+)"/i,
    );

    return {
      descriptions:
        descriptionsMatch?.[1] ||
        'Deskripsi produk medis yang dihasilkan berdasarkan spesifikasi yang tersedia.',
      descriptions_en:
        descriptionsEnMatch?.[1] ||
        'Clinical-grade medical equipment description generated based on available specifications for NHS healthcare environments.',
      benefits:
        benefitsMatch?.[1] ||
        '1. Kualitas medis yang tinggi\n2. Standar keamanan yang ketat\n3. Cocok untuk aplikasi klinis',
      benefits_en:
        benefitsEnMatch?.[1] ||
        '1. Clinical-grade medical quality\n2. NHS-compliant safety standards\n3. Suitable for UK healthcare applications',
    };
  }

